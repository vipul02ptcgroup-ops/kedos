rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Current app uses client-side role checks (not Firebase Auth custom claims).
    // Keep permissive rules so existing reads/writes continue to work.
    // Tighten this once server-enforced auth/authorization is added.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
