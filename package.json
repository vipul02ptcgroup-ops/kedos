{
  "name": "baby-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:next-dir": "node scripts/prepare-next-dir.cjs",
    "dev": "npm run prepare:next-dir && npm exec next dev",
    "build": "npm run prepare:next-dir && npm exec next build",
    "start": "npm run prepare:next-dir && npm exec next start",
    "lint": "next lint",
    "firebase:deploy": "firebase deploy --project kedos-ff9c7 --only firestore,storage",
    "firebase:deploy:rules": "firebase deploy --project kedos-ff9c7 --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.383.0",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
